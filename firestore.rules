rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "kangbyeongyeon05@gmail.com"
          || request.auth.token.email == "gim67507@gmail.com"
        );
    }

    match /submissions/{instagramKey} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.instagramKey == instagramKey
        && request.resource.data.instagram == "@" + instagramKey;

      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if isAdmin();

      // A submitted Instagram ID is immutable, including for its original owner.
      // This keeps the collection strictly one response per normalized ID.
      allow update: if false;

      allow delete: if isAdmin();
    }

    // A privacy-safe existence marker used before the questionnaire starts.
    // It contains no profile or answer data and can only be created when the
    // corresponding private submission already exists.
    match /submissionChecks/{instagramKey} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/submissions/$(instagramKey))
        && request.resource.data.keys().hasOnly(["instagramKey", "submitted", "createdAt"])
        && request.resource.data.instagramKey == instagramKey
        && request.resource.data.submitted == true;

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
